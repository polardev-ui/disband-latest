<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction (backup / device-transfer) rules for Android 12+ (API 31+).
  Keep the auth session out of both cloud backup and device-to-device transfer.
  Both files: the encrypted one is useless on another device anyway, because
  the Keystore key that unlocks it never leaves this one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="disband_sessions.xml" />
        <exclude domain="sharedpref" path="disband_sessions_enc.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="disband_sessions.xml" />
        <exclude domain="sharedpref" path="disband_sessions_enc.xml" />
    </device-transfer>
</data-extraction-rules>
