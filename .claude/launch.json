{
  "version": "0.0.1",
  "autoPort": true,
  "configurations": [
    {
      "name": "disband-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "prototype",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "prototype",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "disband-classic",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "../disband-classic",
        "exec",
        "next",
        "dev",
        "--port",
        "3017"
      ],
      "port": 3017,
      "autoPort": false
    }
  ]
}
