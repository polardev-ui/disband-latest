# dependencies
/node_modules
/.pnp
.pnp.js
.pnp.*
.yarn/*

# next.js
/.next/
/out/
/build
next-env.d.ts

# production
/dist

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# cloudflare (OpenNext build output — rebuilt by `pnpm cf:build`)
.open-next/
.wrangler/

# typescript
*.tsbuildinfo

# tauri / rust
/src-tauri/target/
/src-tauri/gen/
/src/.web-only-stash/
Cargo.lock

# editors / OS
.vscode/
.idea/
**/.DS_Store

# local tooling scratch
.aider*
.freebuff/
.pnpm-store/
*.log

# generated by `pnpm build:tauri`; Tauri rebuilds it via beforeBuildCommand,
# so committing it only creates churn and merge conflicts.
/out/
__pycache__/

# Android
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/.idea/
*.apk

# Android release signing — never commit keys or their passwords.
android/keystore.properties
android/keystore/
*.jks
*.keystore

# Backups of env files — these hold the same secrets as the originals.
.env*.bak
*.env.bak

.DS_Store
# Keep development and production verification builds separate.
/.next-dev/

# Local Pollinations artwork and development records
/.mascot-local/
